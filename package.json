{
  "name": "chatgpt-bmad",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-bmad.mjs",
    "build": "node scripts/build-plugin.mjs",
    "check": "node scripts/validate-manifest.mjs && node scripts/validate-plugin.mjs",
    "integration": "node scripts/integration-smoke.mjs",
    "regenerate": "npm run test:regenerate && node scripts/regenerate.mjs",
    "test:regenerate": "node --test scripts/regenerate.test.mjs",
    "test:compat": "node --test scripts/compatibility-incident.test.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
